{
  "robitnet-claim-guard": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "robitnet hook antigravity-claim-guard",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content"
      }
    ]
  },
  "robitnet-pre-invocation": {
    "PreInvocation": [
      {
        "command": "robitnet hook antigravity-pre-invocation",
        "timeout": 5,
        "type": "command"
      }
    ]
  },
  "robitnet-root-gate": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "robitnet hook antigravity-root-gate",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "mcp__robitnet__(root_.*|memory_write|memory_promote|memory_delete|memory_evidence_set|memory_evidence_clear|memory_verify|memory_link|memory_unlink|episode_.*|claim_.*|mailbox_.*)"
      }
    ]
  },
  "robitnet-stop": {
    "Stop": [
      {
        "command": "robitnet hook antigravity-stop",
        "timeout": 10,
        "type": "command"
      }
    ]
  }
}
