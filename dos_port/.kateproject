{
    "name": "pokeyellow_dos_port",
    "files": [
        {
            "git": 1
        }
    ],
    "lspclient": {
        "servers": {
            "nasm-lsp": {
                "command": [
                    "asm-lsp"
                ],
                "rootIndicationFileNames": [
                    ".asm-lsp.toml"
                ],
                "highlightingModeRegex": "^(Intel x86 \\(NASM\\)|.*[aA]ssembl.*)$"
            }
        }
    }
}
