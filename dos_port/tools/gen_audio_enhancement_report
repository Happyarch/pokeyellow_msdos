#!/usr/bin/env python3
"""
gen_audio_enhancement_report — Render docs/audio_enhancement_status.md from
the audio enhancement/override/sfx YAML sources, plus record maintainer sign-off.

WHAT THIS REPLACES
-------------------
docs/current_plan_audio.md (now archived at docs/plans/audio.md) used to track
per-song arrangement progress as a hand-kept checklist. That was the wrong
shape: a track doesn't need every tier filled in, or any enhancement at all,
to be finished — it needs the maintainer's own sign-off by ear, which no lint
pass or tier count can certify. So this tool splits the two kinds of fact:

  * STRUCTURAL facts (does tools/audio/enhancements/<Song>.yaml exist, what
    tiers does it declare, does tools/audio/overrides/<Song>.yaml exist, what
    do its channels/patches say, and what tools/audio/sfx/<SFX>.yaml profiles exist)
    are read LIVE from the tree every run, the same way project_state/gen_progress_report
    derive their tables.
  * APPROVAL is not inferred from any of that. It lives in
    tools/audio/enhancement_approvals.json, a small file this tool owns and
    writes itself — never hand-edited. Record a sign-off by invoking this
    tool with <TARGET>=1 (clear one with =0), supporting fuzzy matching; see Usage below.

WHAT THIS REPORT DOES NOT PROVE
--------------------------------
Presence of an enhancements/*.yaml, overrides/*.yaml, or sfx/*.yaml file means schema-valid
content exists at that path. It is NOT lint-clean (run yaml_lint.py for that),
NOT audition-tested, and NOT a quality judgment. A song or SFX with zero custom
YAML can still be a finished, signed-off item — not every track needs a full arrangement.
Only the "Approved" column reflects a human decision, and it reflects nothing else.

Usage:
    dos_port/tools/gen_audio_enhancement_report                  # write docs/audio_enhancement_status.md
    dos_port/tools/gen_audio_enhancement_report --stdout          # print instead of writing
    dos_port/tools/gen_audio_enhancement_report MUSIC_LAVENDER=1  # record sign-off by constant
    dos_port/tools/gen_audio_enhancement_report pallet=1         # record sign-off with fuzzy matching
    dos_port/tools/gen_audio_enhancement_report SFX_DAMAGE=1     # record SFX sign-off
    dos_port/tools/gen_audio_enhancement_report damage=1         # record SFX sign-off via fuzzy search
    dos_port/tools/gen_audio_enhancement_report damage=0         # clear sign-off
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

import yaml

SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parents[1]
AUDIO_DIR = SCRIPT_DIR / "audio"
ENH_DIR = AUDIO_DIR / "enhancements"
OVR_DIR = AUDIO_DIR / "overrides"
SFX_DIR = AUDIO_DIR / "sfx"
APPROVALS_PATH = AUDIO_DIR / "enhancement_approvals.json"
OUT_PATH = REPO_ROOT / "docs" / "audio_enhancement_status.md"

sys.path.insert(0, str(AUDIO_DIR))
import gen_audio_data  # noqa: E402

_ASSIGNMENT_RE = re.compile(r"^([^=]+)=([01])$")
TIMBRES_PATH = AUDIO_DIR / "mt32" / "timbres.yaml"
OPL_PATCHES_PATH = AUDIO_DIR / "opl" / "patches.yaml"


def _norm_name(name) -> str:
    return "".join(c for c in str(name).lower() if c.isalnum())


def load_custom_timbre_names() -> dict[str, str]:
    """{normalized_name: display_name} for every custom MT-32 timbre.

    Read live from tools/audio/mt32/timbres.yaml each run. Empty when the
    file is missing or defines no timbres — formatting then falls back to
    raw values, matching the old behavior.
    """
    try:
        data = yaml.safe_load(TIMBRES_PATH.read_text(encoding="utf-8")) or {}
    except (OSError, yaml.YAMLError):
        return {}
    out = {}
    for t in data.get("timbres", []) or []:
        if isinstance(t, dict) and t.get("name"):
            out[_norm_name(t["name"])] = str(t["name"])
    return out


def load_opl_patches() -> dict[str, dict]:
    """{patch_name: patch_info} for every patch defined in tools/audio/opl/patches.yaml."""
    try:
        data = yaml.safe_load(OPL_PATCHES_PATH.read_text(encoding="utf-8")) or {}
    except (OSError, yaml.YAMLError):
        return {}
    return data.get("patches", {}) or {}


def fmt_mt32(value, custom_names):
    """Format one MT-32 patch/program value, starring custom timbres.

    Custom timbres are always referenced by name string (raw ints are
    factory program numbers — the on-the-fly setup only remaps a slot a
    song declares by name), so only a string matching a timbre in
    timbres.yaml gets the '*' footnote marker; everything else prints
    unchanged.
    """
    if isinstance(value, str) and _norm_name(value) in custom_names:
        return f"{custom_names[_norm_name(value)]}*"
    return value


def fmt_opl_patch(value, opl_patches: dict[str, dict]):
    """Format one OPL3 patch name, validating it against patches.yaml."""
    if not value or value == "—":
        return "—"
    if value in opl_patches:
        return value
    return f"{value} (unknown)"


def get_opl_base_channels(enh, ovr):
    """Extract root-level opl_base_channels dictionary from enh or ovr dict."""
    base = None
    if isinstance(enh, dict) and "opl_base_channels" in enh:
        base = enh["opl_base_channels"]
    elif isinstance(ovr, dict) and "opl_base_channels" in ovr:
        base = ovr["opl_base_channels"]
    if not isinstance(base, dict):
        return None
    return base


def fmt_opl_base(base, opl_patches: dict[str, dict]):
    """Format opl_base_channels for the summary table."""
    if not base:
        return "—"
    parts = []
    for k in ("ch1", "ch2", "ch3", "ch4", 1, 2, 3, 4):
        if k in base:
            val = base[k]
            ch_num = str(k).replace("ch", "")
            if val in opl_patches:
                parts.append(f"ch{ch_num}:{val}")
            else:
                parts.append(f"ch{ch_num}:{val}(unknown)")
    return ", ".join(parts) if parts else "—"


def fmt_volume(ch_dict, default=None):
    """Format volume, supporting device-cleaved keys (opl_volume, mt32_volume, gm_volume)."""
    parts = []
    if "opl_volume" in ch_dict:
        parts.append(f"opl:{ch_dict['opl_volume']}")
    if "mt32_volume" in ch_dict:
        parts.append(f"mt32:{ch_dict['mt32_volume']}")
    if "gm_volume" in ch_dict:
        parts.append(f"gm:{ch_dict['gm_volume']}")
    if parts:
        return " / ".join(parts)
    if "volume" in ch_dict:
        return str(ch_dict["volume"])
    return str(default) if default is not None else "—"


def _load_audition():
    spec = importlib.util.spec_from_file_location("audition_main", AUDIO_DIR / "audition.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def cell(value):
    """Table cell values may legally contain '|', which would split the row."""
    return str(value).replace('|', '\\|').replace('\n', ' ')


def md_table(headers, rows):
    out = ['| ' + ' | '.join(headers) + ' |',
           '| ' + ' | '.join('---' for _ in headers) + ' |']
    for r in rows:
        out.append('| ' + ' | '.join(cell(c) for c in r) + ' |')
    return '\n'.join(out)


def canonical_songs():
    """(const_name, header_label) for every MUSIC_* entry in music_constants.asm."""
    consts, _bounds = gen_audio_data.parse_music_constants()
    return sorted((n, l) for n, l in consts.items() if n.startswith("MUSIC_"))


def canonical_sfx():
    """(const_name, header_label) for every SFX_* entry in music_constants.asm."""
    consts, _bounds = gen_audio_data.parse_music_constants()
    return sorted((n, l) for n, l in consts.items() if n.startswith("SFX_"))


def load_yaml_dir(dir_path: Path):
    """{filename_stem: parsed_dict} for every *.yaml directly in dir_path."""
    out = {}
    if not dir_path.exists():
        return out
    for path in sorted(dir_path.glob("*.yaml")):
        with path.open(encoding="utf-8") as fh:
            out[path.stem] = yaml.safe_load(fh) or {}
    return out


def tiers_of(enh_data):
    tiers = {ch.get("tier") for ch in (enh_data or {}).get("channels", [])
             if ch.get("tier") is not None}
    return sorted(tiers)


def patches_of_sfx(sfx_data, opl_patches=None):
    if not sfx_data or "channels" not in sfx_data:
        return "—"
    chans = sfx_data.get("channels", {})
    parts = []
    opl_patches = opl_patches or {}
    for ch in sorted(chans, key=lambda x: int(x) if str(x).isdigit() else str(x)):
        cfg = chans[ch]
        patch = cfg.get("patch", "—") if isinstance(cfg, dict) else "—"
        if patch != "—" and opl_patches and patch not in opl_patches:
            parts.append(f"ch{ch}: {patch} (unknown)")
        else:
            parts.append(f"ch{ch}: {patch}")
    return ", ".join(parts) if parts else "—"


def switches_summary(ovr, enh):
    """Timed mid-song program switches per song: presence + per-channel
    summary (structural fact, like everything else here — not lint-clean,
    run yaml_lint.py for that)."""
    parts = []
    for gb_ch in sorted((ovr or {}).get("channels", {}), key=str):
        c = ovr["channels"][gb_ch]
        if isinstance(c, dict) and c.get("switches"):
            parts.append(f"ovr ch{gb_ch}×{len(c['switches'])}")
    for c in ((enh or {}).get("channels", []) or []):
        if isinstance(c, dict) and c.get("switches"):
            parts.append(f"enh {c.get('name', '?')}×{len(c['switches'])}")
    return ", ".join(parts) if parts else "—"


def switch_lines(ch_switches, custom_names=None):
    """['m15 b4 → mt32 Violin 1 / gm Violin', ...] for one channel's list.

    Custom MT-32 timbres (by-name refs) carry the '*' footnote marker, via
    fmt_mt32; the gm side has no custom path and prints raw.
    """
    custom_names = custom_names or {}
    lines = []
    for sw in ch_switches or []:
        if not isinstance(sw, dict):
            continue
        mt32 = fmt_mt32(sw.get("mt32_program", "—"), custom_names)
        gm = sw.get("gm_program", "—")
        lines.append(f"m{sw.get('m', '?')} b{sw.get('b', '?')} → "
                     f"mt32 {mt32} / gm {gm}")
    return lines


def load_approvals():
    if APPROVALS_PATH.exists():
        return json.loads(APPROVALS_PATH.read_text(encoding="utf-8"))
    return {}


def save_approvals(approvals):
    APPROVALS_PATH.write_text(
        json.dumps(approvals, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def apply_mutations(assignments, const_to_label_m, const_to_label_s, approvals):
    """Validate-then-write <TARGET>=<0|1> args into the approval store, supporting fuzzy matching."""
    if not assignments:
        return False

    audition_mod = _load_audition()
    music_map, sfx_map = audition_mod.get_audio_catalog()
    music_label_to_const = {lbl: c for c, lbl in music_map.items()}
    sfx_label_to_const = {lbl: c for c, lbl in sfx_map.items()}

    changed = False
    for arg in assignments:
        m = _ASSIGNMENT_RE.match(arg.strip())
        if not m:
            sys.exit(f"unrecognized argument: {arg!r} "
                     "(expected <SONG_OR_SFX>=1 or =0)")
        target_raw, flag = m.group(1).strip(), m.group(2)

        # 1. Exact match in constants
        if target_raw in const_to_label_m:
            target_const = target_raw
        elif target_raw in const_to_label_s:
            target_const = target_raw
        elif target_raw in music_label_to_const:
            target_const = music_label_to_const[target_raw]
        elif target_raw in sfx_label_to_const:
            target_const = sfx_label_to_const[target_raw]
        else:
            # 2. Fuzzy match via audition's resolve_audio_label
            try:
                kind, item = audition_mod.resolve_audio_label(target_raw, music_map, sfx_map)
                if kind == "music":
                    target_const = music_label_to_const[item]
                else:
                    target_const = item
            except SystemExit as e:
                sys.exit(f"Could not resolve audio query {target_raw!r}: {e}")

        if flag == "1":
            approvals[target_const] = {
                "approved": True,
                "date": datetime.now(timezone.utc).strftime("%Y-%m-%d"),
            }
            print(f"✓ Recorded approval for {target_const}")
        else:
            if target_const in approvals:
                approvals.pop(target_const, None)
                print(f"Cleared approval for {target_const}")
            else:
                print(f"No existing approval for {target_const} to clear.")
        changed = True

    if changed:
        save_approvals(approvals)
    return changed


def orphan_note(data):
    if isinstance(data, dict) and "schema" in data and any(
            isinstance(ch, dict) and "tier" in ch for ch in data.get("channels", [])):
        return ("enhancement-shaped content (has `channels[].tier`) sitting in "
                "`overrides/` — not read by `load_overrides()`, which only "
                "matches the exact canonical filename")
    if isinstance(data, dict) and "sfx" in data:
        return "sfx profile does not match any canonical SFX constant"
    return "filename does not match any canonical song or SFX label"


def build_report(canonical_music, const_to_label_m, label_to_const_m,
                 canonical_sfx_list, const_to_label_s, label_to_const_s,
                 approvals):
    enh_files = load_yaml_dir(ENH_DIR)
    ovr_files = load_yaml_dir(OVR_DIR)
    sfx_files = load_yaml_dir(SFX_DIR)
    custom_names = load_custom_timbre_names()
    opl_patches = load_opl_patches()

    label_set_m = set(label_to_const_m)
    enh_by_label = {s: d for s, d in enh_files.items() if s in label_set_m}
    enh_orphans = {s: d for s, d in enh_files.items() if s not in label_set_m}
    ovr_by_label = {s: d for s, d in ovr_files.items() if s in label_set_m}
    ovr_orphans = {s: d for s, d in ovr_files.items() if s not in label_set_m}

    # Match SFX yaml files to canonical SFX constants
    sfx_by_const = {}
    sfx_orphans = {}
    for stem, d in sfx_files.items():
        sfx_field = d.get("sfx")
        if sfx_field in const_to_label_s:
            sfx_by_const[sfx_field] = (stem, d)
        else:
            # Fallback stem match
            matched_const = None
            clean_stem = stem.lower().replace("sfx_", "").replace("_", "")
            for c in const_to_label_s:
                if c.lower().replace("sfx_", "").replace("_", "") == clean_stem:
                    matched_const = c
                    break
            if matched_const:
                sfx_by_const[matched_const] = (stem, d)
            else:
                sfx_orphans[stem] = d

    total_m = len(canonical_music)
    n_enh = len(enh_by_label)
    n_ovr = len(ovr_by_label)
    n_opl_base = sum(1 for label in label_set_m
                     if get_opl_base_channels(enh_by_label.get(label), ovr_by_label.get(label)))
    approved_m = [c for c in approvals if c in const_to_label_m and approvals[c].get("approved")]
    n_approved_m = len(approved_m)

    total_s = len(canonical_sfx_list)
    n_sfx_tuned = len(sfx_by_const)
    n_sfx_soft_apu = sum(1 for _, d in sfx_by_const.values() if d.get("playback") == "soft_apu")
    approved_s = [c for c in approvals if c in const_to_label_s and approvals[c].get("approved")]
    n_approved_s = len(approved_s)

    lines = [
        '# Audio Enhancement & Sound Effects Status', '',
        '_Generated by `dos_port/tools/gen_audio_enhancement_report`. Do not'
        ' hand-edit — edit the generator, or run the tool with'
        ' `<SONG_OR_SFX>=1`/`=0` (with fuzzy matching) to change sign-off._', '',
        f'_Last generated: {datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")}_',
        '',
        '> **Presence is a structural fact, not a quality signal.** "Enhancement",'
        ' "Override", and "Tuned Profile" mean a schema-shaped YAML file exists at that path —'
        ' not that it is lint-clean (`yaml_lint.py`) or audition-tested.'
        ' **"Approved" is the one column that reflects a human decision**,'
        ' entered only via `gen_audio_enhancement_report <TARGET>=1`,'
        ' never by hand-editing `tools/audio/enhancement_approvals.json`. A'
        ' song or sound effect with no custom YAML at all can still be legitimately'
        ' finished, and an entry with files present is not thereby approved.', '',
        '## Summary', '',
        '### Music', '',
        md_table(['metric', 'count', 'of 49'], [
            ['has enhancements/*.yaml', n_enh, f'{n_enh}/{total_m}'],
            ['has overrides/*.yaml', n_ovr, f'{n_ovr}/{total_m}'],
            ['has opl_base_channels', n_opl_base, f'{n_opl_base}/{total_m}'],
            ['approved (signed off)', n_approved_m, f'{n_approved_m}/{total_m}'],
        ]), '',
        '### Sound Effects (SFX)', '',
        md_table([f'metric', 'count', f'of {total_s}'], [
            ['has sfx/*.yaml (profile)', n_sfx_tuned, f'{n_sfx_tuned}/{total_s}'],
            ['routed via PCM (Soft APU)*', n_sfx_soft_apu, f'{n_sfx_soft_apu}/{total_s}'],
            ['approved (signed off)', n_approved_s, f'{n_approved_s}/{total_s}'],
        ]), '',
    ]

    # ── Main table ───────────────────────────────────────────────────────
    lines += ['## Per-song status', '']
    rows_m = []
    for const, label in canonical_music:
        enh = enh_by_label.get(label)
        ovr = ovr_by_label.get(label)
        tiers = tiers_of(enh)
        base_ch = get_opl_base_channels(enh, ovr)
        approval = approvals.get(const)
        rows_m.append([
            label,
            'yes' if enh else '—',
            ','.join(str(t) for t in tiers) if tiers else '—',
            'yes' if ovr else '—',
            fmt_opl_base(base_ch, opl_patches),
            switches_summary(ovr, enh),
            f'\u2713 {approval["date"]}' if approval else '—',
        ])
    lines += [md_table(['Song', 'Enhancement', 'Tiers', 'Override', 'OPL Base', 'Switches', 'Approved'], rows_m), '']

    # ── Per-song detail ──────────────────────────────────────────────────
    detail_labels = sorted(set(enh_by_label) | set(ovr_by_label))
    if detail_labels:
        lines += ['## Per-song detail', '',
                  '_Only songs with an enhancement and/or override file get a'
                  ' section here._', '']
        for label in detail_labels:
            const = label_to_const_m[label]
            lines += [f'### {label} (`{const}`)', '']
            enh = enh_by_label.get(label)
            ovr = ovr_by_label.get(label)
            base_ch = get_opl_base_channels(enh, ovr)
            if base_ch:
                lines += ['**OPL base channel overrides** (replaces default GB APU FM patches):', '']
                base_rows = []
                for k in ("ch1", "ch2", "ch3", "ch4", 1, 2, 3, 4):
                    if k in base_ch:
                        val = base_ch[k]
                        ch_num = str(k).replace("ch", "")
                        desc = opl_patches.get(val, {}).get("description", "")
                        valid_mark = "" if val in opl_patches else " *(unknown patch)*"
                        base_rows.append([f"GB ch{ch_num}", f"`{val}`{valid_mark}", desc or "—"])
                lines += [md_table(['Channel', 'OPL Patch', 'Description'], base_rows), '']
            if enh:
                lines += ['**Enhancement channels** — OPL3-specific patch is'
                          ' `opl_patch` (tier 1 only); MT-32/GM patches are'
                          ' `mt32_patch`/`gm_program` on every tier:', '']
                ch_rows = [[
                    c.get('name', '?'), c.get('tier', '?'),
                    fmt_opl_patch(c.get('opl_patch', '—'), opl_patches),
                    fmt_mt32(c.get('mt32_patch', '—'), custom_names),
                    c.get('gm_program', '—'), c.get('pan', 'center'),
                    fmt_volume(c, default=96),
                ] for c in enh.get('channels', [])]
                lines += [md_table(
                    ['Channel', 'Tier', 'OPL Patch', 'MT-32 Patch',
                     'GM Program', 'Pan', 'Volume'], ch_rows), '']
                for c in enh.get('channels', []):
                    sl = switch_lines(c.get('switches'), custom_names) if isinstance(
                        c, dict) else []
                    if sl:
                        lines += [f"Switches on `{c.get('name', '?')}` "
                                  f"(timed mid-song program changes): "
                                  + "; ".join(sl) + ".", '']
            if ovr:
                lines += ['**MT-32/MIDI overrides** (base 4 GB channels'
                          ' 1-3; drums = channel 4/noise):', '']
                ch_rows = []
                for gb_ch in sorted(ovr.get('channels', {}), key=str):
                    c = ovr['channels'][gb_ch]
                    ch_rows.append([
                        gb_ch,
                        fmt_mt32(c.get('mt32_program', '—'), custom_names),
                        c.get('gm_program', '—'),
                        fmt_mt32(c.get('program', '—'), custom_names),
                        fmt_volume(c, default=None), c.get('pan', '—'),
                    ])
                if ch_rows:
                    lines += [md_table(
                        ['GB Channel', 'MT-32 Program', 'GM Program',
                         'Program (fallback)', 'Volume', 'Pan'], ch_rows), '']
                for gb_ch in sorted(ovr.get('channels', {}), key=str):
                    c = ovr['channels'][gb_ch]
                    sl = switch_lines(c.get('switches'), custom_names) if isinstance(
                        c, dict) else []
                    if sl:
                        lines += [f"Switches on GB channel {gb_ch} "
                                  f"(timed mid-song program changes): "
                                  + "; ".join(sl) + ".", '']
                drums = ovr.get('drums')
                if drums:
                    dmap = drums.get('map', {})
                    lines += [f'Drums: velocity {drums.get("velocity", "—")}, '
                              f'{len(dmap)} noise-id \u2192 GM-drum mapping(s).', '']
        if custom_names:
            lines += ['_` * ` marks a custom MT-32 patch/timbre from'
                      ' `tools/audio/mt32/timbres.yaml` (uploaded to User Timbre'
                      ' RAM at boot; selected per song via its staged patch slot).'
                      ' Raw program numbers are factory presets._', '']
        lines += ['_OPL3 patches are defined in `tools/audio/opl/patches.yaml`'
                  ' (18 canonical FM instruments). Root-level `opl_base_channels:`'
                  ' overrides base GB APU channel timbres for OPL3._', '']

    # ── Sound Effects (SFX) status ───────────────────────────────────────
    lines += ['## Sound Effects (SFX) status', '',
              '_Sound effects in Pokémon Yellow have no arrangement enhancement tiers; '
              'each sound effect is either tuned with an authentic OPL3 FM profile in `tools/audio/sfx/`, '
              'routed via Soft APU PCM on Sound Blaster with FM fallback, '
              'or uses default hardware emulation._', '']
    rows_s = []
    for const, label in canonical_sfx_list:
        sfx_entry = sfx_by_const.get(const)
        has_profile = 'yes' if sfx_entry else '—'
        playback_str = '—'
        if sfx_entry:
            pb = sfx_entry[1].get('playback', 'fm')
            playback_str = 'PCM (Soft APU)*' if pb == 'soft_apu' else 'FM'
        patches_str = patches_of_sfx(sfx_entry[1], opl_patches) if sfx_entry else '—'
        appr = approvals.get(const)
        approved_str = f'\u2713 {appr["date"]}' if appr else '—'
        rows_s.append([
            label,
            const,
            has_profile,
            playback_str,
            patches_str,
            approved_str,
        ])
    lines += [md_table(['Sound Effect', 'Constant', 'Profile', 'Playback', 'FM Fallback Patches', 'Approved'], rows_s), '']
    lines += ['_\\* **PCM (Soft APU)**: Synthesized to 8-bit unsigned PCM via the virtual APU core '
              'and streamed asynchronously in the background via Sound Blaster single-cycle DMA. '
              'Automatically falls back to the defined FM profile on sound cards without PCM hardware (e.g. AdLib / OPL2) '
              'or when `/NO_SB` is specified._', '']

    # ── Orphan files ─────────────────────────────────────────────────────
    orphans = ([(f'enhancements/{s}.yaml', d) for s, d in sorted(enh_orphans.items())]
               + [(f'overrides/{s}.yaml', d) for s, d in sorted(ovr_orphans.items())]
               + [(f'sfx/{s}.yaml', d) for s, d in sorted(sfx_orphans.items())])
    lines += ['## Orphan / unmatched files', '']
    if not orphans:
        lines += ['_None found._', '']
    else:
        lines += ['_Files present under `enhancements/`, `overrides/`, or `sfx/` whose'
                  ' name does not match any canonical song or sound effect label —'
                  ' dead weight the pipeline never reads:_', '']
        lines += [md_table(['file', 'note'],
                            [[p, orphan_note(d)] for p, d in orphans]), '']

    lines += ['', '---', '',
              '_To reproduce: `dos_port/tools/gen_audio_enhancement_report`.'
              ' To record sign-off: `dos_port/tools/gen_audio_enhancement_report <TARGET>=1` '
              '(e.g. `damage=1`, `SFX_DAMAGE=1`, `pallet=1`; clear with `=0`)._', '']
    return '\n'.join(lines) + '\n'


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('assignments', nargs='*',
                     help='<SONG_OR_SFX>=1 or =0 to record/clear sign-off '
                          'before generating the report (supports fuzzy matching)')
    ap.add_argument('--stdout', action='store_true',
                     help='print instead of writing docs/audio_enhancement_status.md')
    args = ap.parse_args()

    canonical_m = canonical_songs()
    const_to_label_m = dict(canonical_m)
    label_to_const_m = {label: const for const, label in canonical_m}

    canonical_s = canonical_sfx()
    const_to_label_s = dict(canonical_s)
    label_to_const_s = {label: const for const, label in canonical_s}

    approvals = load_approvals()
    apply_mutations(args.assignments, const_to_label_m, const_to_label_s, approvals)

    report = build_report(canonical_m, const_to_label_m, label_to_const_m,
                          canonical_s, const_to_label_s, label_to_const_s,
                          approvals)
    if args.stdout:
        sys.stdout.write(report)
    else:
        OUT_PATH.write_text(report, encoding='utf-8')
        print(f'Wrote {OUT_PATH.relative_to(REPO_ROOT)}')


if __name__ == "__main__":
    main()
