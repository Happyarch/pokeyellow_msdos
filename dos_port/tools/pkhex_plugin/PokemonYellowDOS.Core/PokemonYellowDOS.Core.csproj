<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0, no WinForms: the platform-neutral core (header format +
         save reader). Testable and runnable on Linux; the Windows-only plugin
         shell lives in PokemonYellowDOS. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to match savegen and the plugin shell (see ../README.md). -->
    <PackageReference Include="PKHeX.Core" Version="26.7.7" />
  </ItemGroup>

</Project>
