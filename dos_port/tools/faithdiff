#!/usr/bin/env python3
"""
faithdiff — mechanical pret-vs-port fidelity diff for one routine
(fidelity plan Stage 2.2).

For a pret label, extracts the routine body on both sides (label → next
top-level label) and compares the **call graph** and the **named-WRAM/HRAM
store set**:

  calls   pret call/jp/jr/predef/farcall/… targets  vs  port call/jmp targets
  stores  pret `ld [wX], …` / `ldh [hX], …`         vs  port `mov [ebp + wX], …`

Reports what the port ADDED and DROPPED relative to pret. Not a semantic
prover — a forcing function: "port calls LoadHudTilePatterns; pret doesn't"
falls out automatically. Known translation boundaries (TODO-HW plumbing,
DelayFrame pipeline, ds_base biasing, port cache bookkeeping) are silenced
via tools/faithdiff_suppress.json:

It ALSO compares call ORDER (added 2026-08-15, maintainer-endorsed): the
first-occurrence sequence of the callees BOTH sides share. Two same-day
regressions were pure reorders invisible to the set diff — the
EnemySendOutFirstMon hoist above the battle intro (mon pic over the trainer
pic) and the colour-before-draw swap in DrawEnemyHUDAndHPBar (full bar on a
fainted mon). Order findings are `! ORDER` WARNINGS by default and never
change the exit code (many collapsed routines legitimately interleave a
folded callee's calls); pass --order-strict to make them violations. The
check sees only callees named on BOTH sides — a reorder against a port-only
or renamed callee (draw_enemy_hp_bar vs pret DrawHPBar) is structurally
invisible to it, same as the rest of this tool.

  { "calls":  { "<Symbol>": "why it is expected on one side only", … },
    "stores": { "<Symbol>": "…" } }

Routine location comes from the Stage 2.1 labels table (translation.db);
run tools/update_label_db first if the tree moved.

Usage:  dos_port/tools/faithdiff <PretLabel> [more labels…] [--all-hits]
Exit 1 if any unsuppressed added/dropped item remains.
"""

import argparse
import json
import os
import re
import sqlite3
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
REPO_ROOT  = os.path.normpath(os.path.join(SCRIPT_DIR, '..', '..'))
DB_PATH    = os.path.join(SCRIPT_DIR, 'translation.db')
SUPPRESS   = os.path.join(SCRIPT_DIR, 'faithdiff_suppress.json')

LABEL_RE = re.compile(r'^([A-Za-z_][A-Za-z0-9_]*):{1,2}')

PRET_CALL_RE = re.compile(
    r'^\s*(call|jp|jr)\s+(?:(?:nz|z|nc|c)\s*,\s*)?([A-Za-z_][A-Za-z0-9_]*)\s*$')
PRET_MACRO_RE = re.compile(
    r'^\s*(predef_jump|predef|farcall|callfar|callba|callab|homecall)'
    r'\s+([A-Za-z_][A-Za-z0-9_]*)\s*$')
# The callee-in-the-macro-NAME form: `farcall_ModifyPikachuHappiness PIKAHAPPY_X`
# (macros/farcall.asm:74,81). The operand is the macro ARGUMENT, so PRET_MACRO_RE
# cannot match and the call is invisible on the pret side, while the port's plain
# `call ModifyPikachuHappiness` reads as a spurious `+ ADDED`. Kept in sync with
# the identical rule in update_label_db (which this file duplicates rather than
# imports — the duplication is why fixing one did not fix the other).
#
# NOTE this is the SAME failure mode the Jcc note below records: a gate that
# cannot see a construct reports a faithful translation as a divergence, and the
# tempting "fix" is to contort the assembly. Measured 2026-08-12: these two
# macros are ModifyPikachuHappiness's ONLY callers (15 sites), so the routine
# read as having zero pret callers and neither a real drop nor a real addition
# could be distinguished.
PRET_MACRO_NAMED_RE = re.compile(
    r'^\s*(?:farcall|callfar)_([A-Za-z_][A-Za-z0-9_]*)\s+\S')
# ld [wX], … / ld [hX], … / ldh [hX], …  (stores only: bracket operand first)
PRET_STORE_RE = re.compile(
    r'^\s*ldh?\s+\[\s*([whWH][A-Za-z0-9_]*)\s*\]\s*,')
# These operand spellings name registers / register-indirect forms, never a
# callee. `jp hl` is the normal pret jump-table dispatch (BattleTransition is
# one such site); counting it as a dropped call forces an impossible x86 label
# match because the corresponding port form is `jmp [Table + index * 4]`.
# Keep this shared with the store filter below.
PRET_REG_INDIRECT = {'hl', 'hli', 'hld', 'bc', 'de', 'c', 'hLoadedROMBank'}

# call / jmp / **any Jcc** to a named target. The conditional forms are not
# optional: the pret side counts `jp z, X` and `jr nz, X` (PRET_CALL_RE's
# `(?:nz|z|nc|c)\s*,`), so a faithful translation written as `je X` / `jnz X`
# read as NOTHING here and the label reported a false `- DROPPED X`. The two
# instances that surfaced this (FlashScreenUnused, and
# AnimationShakeScreenHorizontallySlow's self-recursion, both in
# engine/battle/animations.asm) were "fixed" by rewriting the assembly into
# `jne .skip` + `jmp` — backwards; the tool was wrong. `j[a-z]{1,3}` is the
# same pattern tools/update_label_db's PORT_CALL_RE already used, so the two
# scanners now agree; it spans the whole x86 Jcc set (longest is jnae/jnbe/
# jnge/jnle = j + 3). `loop`/`jcxz`/`jecxz` are deliberately NOT here: `loop`
# occurs only with local `.labels` in this tree and jcxz/jecxz not at all.
# Local labels stay excluded for free — the alternation is anchored `\s*$` and
# the target must start `[A-Za-z_]`, so neither `je .loop` nor the qualified
# `je Routine.local` matches at all (the explicit startswith('.') guard in
# port_sets is belt-and-braces on the same rule).
PORT_CALL_RE = re.compile(
    r'^\s*(call|jmp|j[a-z]{1,3})\s+(?:short\s+|near\s+|dword\s+)?'
    r'([A-Za-z_][A-Za-z0-9_]*)\s*$')
# mov/and/or/xor/add/sub/inc/dec … [ebp + Sym]…, i.e. any RMW/store whose
# FIRST operand is a GB-memory reference by name
PORT_STORE_RE = re.compile(
    r'^\s*(?:mov|and|or|xor|add|sub|inc|dec|shl|shr|rol|ror|not|neg)'
    r'(?:\s+(?:byte|word|dword))?\s+\[\s*ebp\s*\+\s*([A-Za-z_][A-Za-z0-9_]*)')
PORT_REGS = {'eax', 'ebx', 'ecx', 'edx', 'esi', 'edi', 'esp',
             'ax', 'bx', 'cx', 'dx', 'si', 'di'}

def strip_comment(line):
    out, in_str = [], False
    for ch in line:
        if ch == '"':
            in_str = not in_str
        elif ch == ';' and not in_str:
            break
        out.append(ch)
    return ''.join(out)

MISSING_FILE = object()   # distinct from None ("label not in this file")


def extract_body(path, label):
    """Return the routine body lines: from `label:` to the next column-0 label.

    Returns MISSING_FILE when the file itself is gone. That is a real case, not
    a defensive branch: an upstream pret merge can DELETE the file a DB row
    still points at (upstream bd1b695b moved engine/pikachu/pikachu_pcm.asm to
    audio/), and a stale DB then sent this straight into a FileNotFoundError
    traceback — which fidelity_gate's move battery captured as its baseline.
    """
    try:
        text = open(path, encoding='utf-8', errors='replace').read()
    except OSError:
        return MISSING_FILE
    lines = text.splitlines()
    body, active = [], False
    for raw in lines:
        line = strip_comment(raw)
        m = LABEL_RE.match(line)
        if m:
            if active and m.group(1) != label:
                break
            if m.group(1) == label:
                active = True
            line = line[m.end():]
        if active:
            body.append(line)
    return body if active else None

def pret_sets(body):
    calls, stores, seq = {}, {}, []
    for line in body:
        m = PRET_CALL_RE.match(line) or PRET_MACRO_RE.match(line)
        if m and m.group(2) not in PRET_REG_INDIRECT:
            calls.setdefault(m.group(2), []).append(m.group(1))
            seq.append(m.group(2))
        else:
            m = PRET_MACRO_NAMED_RE.match(line)
            if m:
                calls.setdefault(m.group(1), []).append('farcall')
                seq.append(m.group(1))
        m = PRET_STORE_RE.match(line)
        if m and m.group(1) not in PRET_REG_INDIRECT:
            stores[m.group(1)] = stores.get(m.group(1), 0) + 1
    return calls, stores, seq

def port_sets(body):
    calls, stores, seq = {}, {}, []
    for line in body:
        m = PORT_CALL_RE.match(line)
        if m and not m.group(2).startswith('.'):
            calls.setdefault(m.group(2), []).append(m.group(1))
            seq.append(m.group(2))
        m = PORT_STORE_RE.match(line)
        if m and m.group(1) not in PORT_REGS:
            stores[m.group(1)] = stores.get(m.group(1), 0) + 1
    return calls, stores, seq

def first_occurrence_seq(seq, names):
    """Project a raw call sequence onto `names`, keeping first occurrences only.

    First-occurrence order is the deliberate granularity: it captures "X was
    hoisted above Y" (the shipped regression class) while staying silent on
    repeat-call interleavings, which faithful translations reshuffle freely
    (loops unrolled differently, a folded callee's repeats).
    """
    out = []
    for n in seq:
        if n in names and n not in out:
            out.append(n)
    return out

def lcs_keep(a, b):
    """Names forming a longest common subsequence of a and b (small inputs)."""
    dp = [[0] * (len(b) + 1) for _ in range(len(a) + 1)]
    for i in range(len(a) - 1, -1, -1):
        for j in range(len(b) - 1, -1, -1):
            dp[i][j] = dp[i + 1][j + 1] + 1 if a[i] == b[j] \
                else max(dp[i + 1][j], dp[i][j + 1])
    i = j = 0
    keep = []
    while i < len(a) and j < len(b):
        if a[i] == b[j]:
            keep.append(a[i]); i += 1; j += 1
        elif dp[i + 1][j] >= dp[i][j + 1]:
            i += 1
        else:
            j += 1
    return keep

def norm_sym(s):
    """Case-fold + strip the port's W_/H_ prefixes so wTileMap == W_TILEMAP."""
    s = re.sub(r'^[wh]_?', '', s, flags=re.I)
    return s.replace('_', '').lower()

def diff_one(cur, label, suppress, show_all, order_strict=False):
    row = cur.execute("SELECT pret_file, port_file, status FROM labels "
                      "WHERE name=? AND pret_file IS NOT NULL", (label,)).fetchone()
    if not row:
        print(f"faithdiff: {label}: not a pret label (labels table)")
        return 1
    pret_file, port_file, status = row
    print(f"\n=== faithdiff {label} ===")
    print(f"pret: {pret_file}   port: {port_file or '(none)'}   status: {status}")
    if not port_file:
        print("  no port body to diff (missing/stub)")
        return 1

    pret_body = extract_body(os.path.join(REPO_ROOT, pret_file), label)
    port_body = extract_body(os.path.join(REPO_ROOT, port_file), label)
    for side, path, body in (("pret", pret_file, pret_body),
                             ("port", port_file, port_body)):
        if body is MISSING_FILE:
            print(f"  ERROR: the {side} file {path} does not exist. The DB is "
                  f"stale relative to the tree (an upstream merge can move or "
                  f"delete a pret file) — run tools/update_label_db.")
            return 1
    if pret_body is None or port_body is None:
        print("  ERROR: body extraction failed "
              f"(pret={'ok' if pret_body else 'MISSING'}, "
              f"port={'ok' if port_body else 'MISSING'}) — rescan?")
        return 1

    pcalls, pstores, pseq = pret_sets(pret_body)
    qcalls, qstores, qseq = port_sets(port_body)

    violations = 0
    sup_calls  = suppress.get('calls', {})
    sup_stores = suppress.get('stores', {})

    dropped = sorted(set(pcalls) - set(qcalls))
    added   = sorted(set(qcalls) - set(pcalls))
    common  = sorted(set(pcalls) & set(qcalls))
    print(f"  calls: {len(pcalls)} pret / {len(qcalls)} port"
          f" ({len(common)} matched)")
    for name in dropped:
        kinds = '/'.join(sorted(set(pcalls[name])))
        if name in sup_calls:
            if show_all:
                print(f"    ~ dropped  {name} ({kinds})  [suppressed: {sup_calls[name]}]")
        else:
            print(f"    - DROPPED  {name} ({kinds})")
            violations += 1
    for name in added:
        kinds = '/'.join(sorted(set(qcalls[name])))
        if name in sup_calls:
            if show_all:
                print(f"    ~ added    {name} ({kinds})  [suppressed: {sup_calls[name]}]")
        else:
            print(f"    + ADDED    {name} ({kinds})")
            violations += 1

    pnorm = {norm_sym(s): s for s in pstores}
    qnorm = {norm_sym(s): s for s in qstores}
    sdrop = sorted(pnorm[k] for k in set(pnorm) - set(qnorm))
    sadd  = sorted(qnorm[k] for k in set(qnorm) - set(pnorm))
    print(f"  stores: {len(pstores)} pret / {len(qstores)} port"
          f" ({len(set(pnorm) & set(qnorm))} matched by name)")
    for name in sdrop:
        if name in sup_stores:
            if show_all:
                print(f"    ~ dropped  [{name}]  [suppressed: {sup_stores[name]}]")
        else:
            print(f"    - DROPPED  [{name}]")
            violations += 1
    for name in sadd:
        if name in sup_stores:
            if show_all:
                print(f"    ~ added    [{name}]  [suppressed: {sup_stores[name]}]")
        else:
            print(f"    + ADDED    [{name}]")
            violations += 1

    # --- call ORDER: first-occurrence sequence of the shared callees ---------
    shared = set(pcalls) & set(qcalls)
    po = first_occurrence_seq(pseq, shared)
    qo = first_occurrence_seq(qseq, shared)
    if po != qo:
        keep = set(lcs_keep(po, qo))
        movers = [n for n in po if n not in keep]
        tag = "VIOLATION" if order_strict else "warning, exit code unchanged"
        print(f"  order: DIVERGES on {len(movers)} of {len(po)} shared callees ({tag})")
        for n in movers:
            print(f"    ! ORDER    {n}  (pret pos {po.index(n) + 1}, "
                  f"port pos {qo.index(n) + 1})")
        print(f"    pret: {' > '.join(po)}")
        print(f"    port: {' > '.join(qo)}")
        if order_strict:
            violations += len(movers)
    elif po:
        print(f"  order: in pret order ({len(po)} shared callees)")

    if violations == 0:
        print("  clean (after suppressions)")
    return 1 if violations else 0

def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('labels', nargs='+', metavar='PretLabel')
    ap.add_argument('--all-hits', action='store_true',
                    help='also show suppressed items (with their whys)')
    ap.add_argument('--order-strict', action='store_true',
                    help='count call-ORDER divergence as a violation (default: '
                         'warning only — collapsed routines interleave freely)')
    ap.add_argument('--db', default=DB_PATH,
                    help='read an alternate translation.db — e.g. a temp rescan, '
                         'so a caller can diff before/after without dirtying the '
                         'tracked DB (matches lint_pret_labels and update_label_db)')
    args = ap.parse_args()

    suppress = {}
    if os.path.exists(SUPPRESS):
        with open(SUPPRESS, encoding='utf-8') as fh:
            suppress = json.load(fh)

    con = sqlite3.connect(args.db)
    rc = 0
    for label in args.labels:
        rc |= diff_one(con.cursor(), label, suppress, args.all_hits,
                       args.order_strict)
    sys.exit(rc)

if __name__ == '__main__':
    main()
