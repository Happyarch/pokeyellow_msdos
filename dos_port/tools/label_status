#!/usr/bin/env python3
"""
label_status — "check before you call" query over the Stage 2.1 label DB
(fidelity plan Stage 2.4).

  label_status <Label> [...]      status, pret file, port file, stub file
  label_status --callees <Label>  every call target of the pret routine
                                  (from the `calls` table) with each target's
                                  port status — answers "what do I extern vs
                                  stub for this translation?"
  label_status --callers <Label>  every PORT routine calling <Label> (calls
                                  table, side=port) + every file externing it
                                  with its trailing comment — the stub
                                  retirement checklist (repoint comments,
                                  audit callers for stub-era assumptions).
  label_status --subsystem PAT    what is left in a subsystem: every label whose
                                  pret file matches PAT (a substring, or a glob
                                  with * / ?), as a per-file coverage table plus
                                  the missing/stub names with their port callers.
                                  PAT is matched against the PRET path, so
                                  `--subsystem overworld` covers home/overworld.asm
                                  and engine/overworld/ together.
                                  `--all` also lists the translated names.

  NOT A SECOND INVENTORY, and deliberately so: --subsystem is a thin VIEW over
  the same `labels` table dependency_graph.py reads, so the two cannot disagree.
  The viewer already covers the HUMAN version of this question — tick "unported"
  in its status filter and type a path in its search box. What this adds is the
  terminal one-liner, a per-FILE coverage rollup (the viewer draws nodes, not
  file totals), and the port-callers column inline. If you want it in the
  browser, use the viewer; do not build a third thing.

  *** READ THE COUNT CORRECTLY. *** --subsystem reports tier='core' only, because
  that is the only tier with a mirror rule and call-graph edges; script-tier rows
  carry a status but no edges, so "port callers" is meaningless for them. And a
  `missing` row is NOT automatically work to do: much of what pret puts in a file
  is replaced wholesale by a port mechanism (the VRAM row/column staggering, for
  instance, has no counterpart in a surface renderer), and some is a NAME FORK —
  present under a port-local name, which reads exactly like absent. Check before
  reporting a number as a backlog.

Data comes from translation.db; run tools/update_label_db first if the tree
changed. The DB is rescan-derived — never edit it by hand.
"""

import argparse
import os
import sqlite3
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
DB_PATH    = os.path.join(SCRIPT_DIR, 'translation.db')

def fmt_row(row):
    name, pret_file, port_file, status, stub_file = row
    out = f"{name:<36} {status:<10}"
    if pret_file:
        out += f" pret={pret_file}"
    if port_file:
        out += f" port={port_file}"
    if stub_file:
        out += f" stub={stub_file}"
    return out

def status_of(cur, name):
    return cur.execute(
        "SELECT name, pret_file, port_file, status, stub_file FROM labels "
        "WHERE name=?", (name,)).fetchone()

def subsystem_report(cur, pat, show_all):
    """Per-file coverage for every core-tier label whose PRET path matches pat."""
    # A bare word is a substring match; anything with a glob char is a glob.
    like = pat if any(ch in pat for ch in '*?') else f'*{pat}*'
    rows = cur.execute("""
        SELECT name, pret_file, status FROM labels
        WHERE tier='core' AND pret_file GLOB ?
        ORDER BY pret_file, name""", (like,)).fetchall()
    if not rows:
        print(f"no core-tier pret files match {pat!r} "
              f"(try a fragment of the path, e.g. 'overworld' or 'engine/battle')")
        return 1

    files = {}
    for name, pf, st in rows:
        files.setdefault(pf, []).append((name, st))

    print(f"{'pret file':<52} {'missing':>7} {'stub':>5} {'transl':>7} {'total':>6}")
    tot = [0, 0, 0, 0]
    for pf in sorted(files, key=lambda f: (-sum(1 for _, s in files[f] if s == 'missing'), f)):
        ls = files[pf]
        m = sum(1 for _, s in ls if s == 'missing')
        b = sum(1 for _, s in ls if s == 'stub')
        t = sum(1 for _, s in ls if s == 'translated')
        print(f"{pf:<52} {m:7} {b:5} {t:7} {len(ls):6}")
        tot = [tot[0] + m, tot[1] + b, tot[2] + t, tot[3] + len(ls)]
    print(f"{'TOTAL':<52} {tot[0]:7} {tot[1]:5} {tot[2]:7} {tot[3]:6}")

    wanted = ('missing', 'stub') if not show_all else ('missing', 'stub', 'translated')
    for pf in sorted(files):
        listed = [(n, s) for n, s in files[pf] if s in wanted]
        if not listed:
            continue
        print(f"\n### {pf}")
        for name, st in listed:
            callers = [r[0] for r in cur.execute(
                "SELECT DISTINCT caller FROM calls WHERE callee=? AND side='port'",
                (name,))]
            tag = {'missing': 'miss', 'stub': 'STUB', 'translated': ' ok '}[st]
            print(f"  [{tag}] {name:<38} "
                  f"port callers: {', '.join(callers) if callers else '(none)'}")
    print("\nA `missing` row is not automatically work: some are replaced wholesale "
          "by a port mechanism, and some are NAME FORKS (present under a port-local "
          "name). `port callers: (none)` on a missing row is the usual shape of "
          "both. Verify against the source before treating a count as a backlog.")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('names', nargs='*', metavar='Label')
    ap.add_argument('--subsystem', metavar='PAT',
                    help='list a subsystem\'s labels by pret-path match')
    ap.add_argument('--all', action='store_true',
                    help='--subsystem: also list translated labels')
    ap.add_argument('--callees', action='store_true',
                    help='report the pret routine\'s call targets + statuses')
    ap.add_argument('--callers', action='store_true',
                    help='report port callers + externs of the label')
    args = ap.parse_args()

    con = sqlite3.connect(DB_PATH)
    cur = con.cursor()
    rc = 0

    if args.subsystem:
        sys.exit(subsystem_report(cur, args.subsystem, args.all))
    if not args.names:
        ap.error('give one or more Labels, or --subsystem PAT')

    for name in args.names:
        row = status_of(cur, name)
        if row is None:
            print(f"{name}: not in the label DB (typo? data/-owned? rescan?)")
            rc = 1
            continue
        print(fmt_row(row))

        if args.callees:
            targets = cur.execute("""
                SELECT callee, GROUP_CONCAT(DISTINCT kind) FROM calls
                WHERE caller=? AND side='pret' GROUP BY callee
                ORDER BY callee""", (name,)).fetchall()
            if not targets:
                print("  (no pret call targets recorded — leaf routine, or "
                      "caller not scanned)")
            for callee, kinds in targets:
                trow = status_of(cur, callee)
                if trow:
                    _, _, port_file, status, stub_file = trow
                    where = port_file or stub_file or ''
                    print(f"  -> {callee:<32} {kinds:<12} {status:<10} {where}")
                else:
                    print(f"  -> {callee:<32} {kinds:<12} (not in DB — "
                          f"macro/data label?)")

        if args.callers:
            callers = cur.execute("""
                SELECT caller, file, line, kind FROM calls
                WHERE callee=? AND side='port'
                ORDER BY file, line""", (name,)).fetchall()
            # The complete source inventory, deliberately unfiltered by
            # build_active: this is the stub-retirement checklist and promises
            # every PORT routine calling <Label>, including check-only
            # providers. kind='fallthrough' rows are sequential label
            # boundaries — a real control-flow reference into <Label>.
            print(f"  port callers ({len(callers)}):")
            for caller, file, line, kind in callers:
                print(f"    {caller:<32} {kind:<11} {file}:{line}")
            externs = cur.execute("""
                SELECT file, line, comment FROM externs WHERE symbol=?
                ORDER BY file, line""", (name,)).fetchall()
            print(f"  externs ({len(externs)}):")
            for file, line, comment in externs:
                print(f"    {file}:{line}"
                      + (f"  ; {comment}" if comment else "  (no comment)"))

    sys.exit(rc)

if __name__ == '__main__':
    main()
