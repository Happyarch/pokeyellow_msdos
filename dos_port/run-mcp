#!/usr/bin/env bash
# dos_port/run-mcp — like dos_port/run, but under the MCP-patched DOSBox-X so
# an agent can drive the heavy debugger live (breakpoints, memory, frame
# dumps) while a human pilots headed.
#
# Like run/run-mt32:
#   - it BUILDS: `make image` with any non-`/…` args (e.g. `run-mcp SKIP_TITLE=1`);
#   - '/…' tokens become PKMN.EXE flags (e.g. `run-mcp /MT32`), same split as run;
#   - C: is the isolated PKMN.IMG image, so the run loads the SAME working
#     POKEMON.DSV save as run/run-mt32 (the old script mounted the host
#     dos_port/ dir and saw a different, stale save).
#
# Consequence of the image: files the game writes (POKEMON.DSV on save,
# FRAME.BIN/DUMP.BIN/GBSTATE.BIN from harness builds) land INSIDE the image —
# extract them with e.g.
#   mcopy -n -i PKMN.IMG@@1048576 ::FRAME.BIN .
# (1048576 = partition byte offset). The debugger's own MEMDUMP.BIN still
# lands on the host (emulator CWD), as does the MCP screenshot() output.
#
# Usage:
#   dos_port/run-mcp [make args] [/EXE flags]
#
# Steps:
#   1. Build PKMN.EXE + refresh it inside PKMN.IMG (a save already in the
#      image is preserved across rebuilds — same as run).
#   2. Write the launch handshake (/tmp/dosbox-mcp.launch) recording WHICH
#      build is being launched, so the long-lived MCP server resolves symbols
#      against this checkout instead of the one it was started in.
#   3. Launch tools/dosbox-x-mcp/dosbox-x-mcp with a generated conf that
#      enables the heavy debugger and the MCP socket.
#
# The MCP server (tools/dosbox_mcp/server.py) is registered via
# .claude/settings.json and started automatically by Claude Code.
# You don't need to start it manually.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DOSPORT="$SCRIPT_DIR"
# dosbox-x-mcp: the Happyarch/dosbox-x fork (submodule tools/dosbox-x, branch
# mcp-debug), deliberately named so it never collides with the system dosbox-x.
BINARY="${DOSPORT}/tools/dosbox-x-mcp/dosbox-x-mcp"
# Overridable so two worktrees can each run an instance at once. The default is
# unchanged, so a single-tree workflow behaves exactly as before. This MUST stay
# in sync with dosbox_mcp/server.py, which reads the same variable with the same
# default -- point the server at one socket and the emulator at another and the
# MCP tools connect to nothing, with no error that says why.
SOCK_PATH="${DOSBOX_MCP_SOCKET:-/tmp/dosbox-mcp.sock}"
LAUNCH_FILE="${DOSBOX_MCP_LAUNCH:-/tmp/dosbox-mcp.launch}"

make_args=()
exe_args=()
for a in "$@"; do
    case "$a" in
        /*) exe_args+=("$a") ;;
        *)  make_args+=("$a") ;;
    esac
done

if [ ! -x "$BINARY" ]; then
    echo "ERROR: patched binary not found at $BINARY"
    echo "Run: dos_port/tools/build_dosbox_mcp.sh"
    exit 1
fi

# Same guard as dos_port/run: a live session holds PKMN.IMG mounted rw —
# rebuilding/double-mounting under it corrupts the run (verified 2026-07-07).
if command -v fuser >/dev/null && fuser -s "$DOSPORT/PKMN.IMG" 2>/dev/null; then
    echo "run-mcp: PKMN.IMG is held open by a running DOSBox-X session —" >&2
    echo "         close it before launching another run." >&2
    exit 1
fi

# Build the EXE + refresh it inside the disk image (save data in the image is
# preserved across rebuilds; delete PKMN.IMG or `make clean-image` to reset).
make -C "$DOSPORT" image "${make_args[@]}"

# Scratch conf: the tracked dos_port/dosbox-x.conf, plus the MCP socket, a
# pinned captures dir, and any /EXE flags — the same load pattern as run and
# run-mt32 (which sed/append onto the same file), so machine/cpu/render/video
# settings can never drift from the tested config. [log] is appended fresh
# (the tracked conf has no [log] section); captures is inserted into the
# existing [dosbox] section.
CONF="$(mktemp --suffix=.conf)"
trap 'rm -f "$CONF"' EXIT
CAPTURE_DIR="${DOSBOX_MCP_CAPTURE_DIR:-/tmp/dosbox-mcp-capture}"
mkdir -p "$CAPTURE_DIR"
sed -e "s|^PKMN.EXE\$|PKMN.EXE${exe_args:+ ${exe_args[*]}}|" \
    -e "/^\[dosbox\]$/a captures=${CAPTURE_DIR}" \
    "$DOSPORT/dosbox-x.conf" > "$CONF"
cat >> "$CONF" <<EOF

[log]
# MCP debug socket — lets the MCP client drive the heavy debugger live
mcp_socket=${SOCK_PATH}
EOF

# Launch handshake — tells the MCP server WHICH BUILD it is now debugging.
# The server (tools/dosbox_mcp/server.py) is long-lived and started by Claude
# Code from whatever checkout it was registered in; without this it resolved
# pkmn.sym from ITS OWN directory, so a worktree build got main-checkout
# addresses (right symbol name, plausible address, breakpoint never fires).
# This script is the only party that knows the answer, so it records it here.
# Written atomically (temp + mv) because the server re-reads it on mtime
# change and must never see a half-written path.
cat > "${LAUNCH_FILE}.$$" <<EOF
# Written by run-mcp — the build the emulator is currently running.
# Consumed by tools/dosbox_mcp/server.py (KEY=VALUE, DOSPORT is load-bearing).
DOSPORT=${DOSPORT}
REPO=${REPO_ROOT}
SOCKET=${SOCK_PATH}
LAUNCH_PID=$$
EOF
mv -f "${LAUNCH_FILE}.$$" "${LAUNCH_FILE}"

echo ""
echo "Starting MCP-patched DOSBox-X..."
echo "  Socket:  ${SOCK_PATH}"
echo "  Build:   ${DOSPORT}  (recorded in ${LAUNCH_FILE})"
echo "  Binary:  ${BINARY}"
echo "  Image:   ${DOSPORT}/PKMN.IMG (same working save as dos_port/run)"
echo "  PKMN.EXE boots and free-runs; pause it from MCP to set breakpoints."
echo ""
echo "From Claude Code: pause_exec() once in-game, then set_breakpoint('OverworldLoop'),"
echo "  continue_exec(), gb_read(), dump_frame() etc."
echo ""

# No -break-start: breakpoints need the game's runtime CS/DS selectors, which
# only exist once PKMN.EXE is loaded — the MCP flow is pause_exec() →
# set_breakpoint() → continue_exec().  (At BIOS entry there is nothing to
# target, and a paused emulator can't service the socket BREAK request.)
# The socket is started from DEBUG_Init so it is ready as soon as DOSBox-X opens.
# cd: the debugger writes MEMDUMP.BIN to its CWD; keep that next to PKMN.EXE
# where the MCP server (DOSBOX_MCP_DIR) expects it.
cd "$DOSPORT"
exec "$BINARY" \
    -defaultdir "$DOSPORT" \
    -conf "$CONF"
