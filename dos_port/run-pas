#!/usr/bin/env bash
# dos_port/run-pas — like dos_port/run, but as a PC with a Pro Audio Spectrum 16
# (`sbtype = pas16`) and /PAS on the game's command line (the card's mixer is
# write-only from the driver's chair, so the flag IS the detection — see
# src/audio/pas_shim.asm). Music + SFX play on the card's OPL3 at 0x388; the
# Pikachu cry falls through to the PC-speaker PWM player (the G1 tick voices FM
# only, no PCM path). The PC speaker stays enabled as the PCM fallback path.
#
# NOTE: the card is emulated by the FORK (tools/dosbox-x-mcp), NOT the system
# dosbox-x — /usr/bin/dosbox-x predates upstream's PAS support and has no PAS at
# all, so it can never detect the card.
#
# Args split like dos_port/run-mt32: '/...' tokens become extra PKMN.EXE
# flags (on top of /PAS), the rest go to make, e.g.:
#   dos_port/run-pas DEBUG_AUDIO=1 /LOOP
set -e
DOSPORT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

make_args=()
exe_args=()
for a in "$@"; do
    case "$a" in
        /*) exe_args+=("$a") ;;
        *)  make_args+=("$a") ;;
    esac
done

# Same guard as dos_port/run: a live session holds PKMN.IMG mounted rw —
# rebuilding/double-mounting under it corrupts the run (verified 2026-07-07,
# and re-verified 2026-09-18 when a stray session page-faulted a runner).
if command -v fuser >/dev/null && fuser -s "$DOSPORT/PKMN.IMG" 2>/dev/null; then
    echo "run-pas: PKMN.IMG is held open by a running DOSBox-X session —" >&2
    echo "        close it before launching another run." >&2
    exit 1
fi

make -C "$DOSPORT" image "${make_args[@]}"

CONF="$(mktemp --suffix=.conf)"
trap 'rm -f "$CONF"' EXIT
sed "s|^PKMN.EXE\$|PKMN.EXE /PAS ${exe_args[*]}|" "$DOSPORT/dosbox-x.conf" > "$CONF"
cat >> "$CONF" <<EOF

[sblaster]
sbtype  = pas16
oplmode = auto

[speaker]
pcspeaker = true
EOF

# The card is emulated by the FORK, not the system dosbox-x (see the header).
BINARY="${DOSPORT}/tools/dosbox-x-mcp/dosbox-x-mcp"
if [ ! -x "$BINARY" ]; then
    echo "run-pas: fork binary not found: $BINARY" >&2
    echo "        build it with dos_port/tools/build_dosbox_mcp.sh" >&2
    exit 1
fi
exec "$BINARY" -defaultdir "$DOSPORT" -defaultconf -conf "$CONF"
