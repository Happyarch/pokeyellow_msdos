#!/bin/sh
# pre-commit — run the DOS port's STATIC gate before every commit.
#
# Install with:   make -C dos_port install-hooks   (sets core.hooksPath)
# Undo with:      git config --unset core.hooksPath
# Bypass once:    git commit --no-verify
#
# WHY A HOOK AT ALL. Backlog item 4: every gate in this repo was manual and
# therefore skippable, and two documented failures came straight out of that —
# the strict-claims counts quoted in CLAUDE.md/AGENTS.md/a skill were false for
# a long time, and two test_label_db.py tests were red for an unknown number of
# sessions. Neither was a hard problem; both were invisible because nothing ran
# the check. This hook makes the cheap tier automatic.
#
# WHAT IT DOES NOT DO. It does not run `make fidelity` / `fidelity-full` /
# `goldens-verify`. Those need DOSBox-X, mGBA and a built ROM, take minutes, and
# would make the hook something people reflexively --no-verify past. The runtime
# tier stays an explicit, deliberate step before a behaviour-changing commit.
# A green hook is NOT evidence that behaviour is unchanged.
set -e

root=$(git rev-parse --show-toplevel)

# Nothing under dos_port/ staged? The static gate has nothing to say.
if git diff --cached --quiet -- "$root/dos_port"; then
    exit 0
fi

if [ ! -x "$root/dos_port/tools/static_gate" ]; then
    echo "pre-commit: dos_port/tools/static_gate is missing or not executable; skipping." >&2
    exit 0
fi

# Retiring a relocation row raises registry_approval from 0 to 1 BY CONSTRUCTION:
# the allowlist's SHA-256 stops matching the maintainer's approval, and only the
# maintainer can re-bless. Without this, the hook blocks the registry step of
# EVERY grind unit, and a hook you routinely --no-verify past is a hook you stop
# reading — the same erosion that let a red test suite survive for sessions.
#
# So: when pret_label_allowlist.json is ITSELF in the staged set, this is a
# deliberate registry edit and that one class is tolerated. Nothing can be
# sneaked past — the finding still fires on every SUBSEQUENT commit until the
# maintainer re-blesses, so an unapproved registry cannot quietly persist. Every
# other class is still enforced in full.
#
# AND IT PRINTS THE HASH. This block used to say "hand the new SHA-256 to the
# maintainer" without ever printing one, which left an agent to source a
# 64-hex-character value from somewhere. In session 15 an agent sourced it from
# nowhere: it wrote a well-formed, entirely fabricated hash into the retirement
# commit message, and only caught it because that same message told the reader
# to verify with sha256sum. A hash has no semantic content, so nothing about a
# wrong one looks wrong. The fix is not vigilance — it is never leaving a slot
# for an unmeasured value. The hook has the file; the hook computes it.
# (Hash the WORKTREE file, because that is what lint_pret_labels' own
# registry_approval hashes -- see its open(ALLOWLIST,'rb'). Do not switch this
# to `git show :path` without changing that too, or the gate and the hook will
# disagree the moment someone stages and then edits.)
GATEFLAGS=
if ! git diff --cached --quiet -- "$root/dos_port/tools/pret_label_allowlist.json"; then
    GATEFLAGS=--allow-unapproved-registry
    allowlist_sha=$(sha256sum "$root/dos_port/tools/pret_label_allowlist.json" | cut -d' ' -f1)
    rows=$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1]))["relocated_labels"]))' \
           "$root/dos_port/tools/pret_label_allowlist.json" 2>/dev/null || echo '?')
    echo "pre-commit: pret_label_allowlist.json is staged — treating this as a"
    echo "pre-commit: deliberate registry edit; registry_approval is reported as"
    echo "pre-commit: INFO for this commit only. It will block again on the next"
    echo "pre-commit: commit until the maintainer re-blesses."
    echo "pre-commit:"
    echo "pre-commit: MAINTAINER ACTION — $rows relocation row(s). Agents must NOT run this:"
    echo "pre-commit:"
    echo "pre-commit:   git config pokeyellow.pretAllowlistApprovedSha256 \\"
    echo "pre-commit:     $allowlist_sha"
    echo "pre-commit:"
    echo "pre-commit: That value was COMPUTED from the file just now. Do not retype it;"
    echo "pre-commit: copy it, or re-derive it with:"
    echo "pre-commit:   sha256sum dos_port/tools/pret_label_allowlist.json"
fi

echo "pre-commit: running the static gate (make -C dos_port static_gate)..."
if ! make -C "$root/dos_port" static_gate GATEFLAGS="$GATEFLAGS"; then
    cat >&2 <<'EOF'

pre-commit: the STATIC gate failed. The commit was not created.

  * A class that GREW is your regression — fix it.
  * A class that SHRANK is good news, but lower the ratchet deliberately:
        dos_port/tools/static_gate --update-baseline
    and say in the commit message WHY it moved.
  * registry_approval firing means pret_label_allowlist.json changed and the
    maintainer has not re-blessed it. Agents must NOT set that approval; print
    the hash and stop. (If you are RETIRING rows, stage the allowlist in the
    same commit and this class is tolerated for that commit only.)

  Bypass (and say so in the commit message): git commit --no-verify
EOF
    exit 1
fi
