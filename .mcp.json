{
  "mcpServers": {
    "dosbox-mcp": {
      "args": [
        "dos_port/tools/dosbox_mcp/server.py"
      ],
      "command": "python3",
      "env": {
        "DOSBOX_MCP_SOCKET": "/tmp/dosbox-mcp.sock"
      }
    },
    "nasm-lsp": {
      "args": [
        "dos_port/tools/asm_lsp_mcp/server.py"
      ],
      "command": "python3"
    },
    "rgbds-lsp": {
      "args": [
        "tools/rgbds_lsp_mcp/server.py"
      ],
      "command": "python3"
    },
    "stigmergy": {
      "args": [
        "mcp"
      ],
      "command": "stigmergy"
    }
  }
}
