# editor swap files
*.kate-swp

# compiled objects
*.o

# compiled graphics
*.1bpp
*.2bpp
*.pic

# compiled audio
*.pcm

# compiled roms
*.gbc
*.gb
*.patch

# rgbds extras
*.map
*.sym

# tool binaries (pret)
*.exe
*.EXE

# DOS port build artifacts and test helpers
dos_port/**/*.o
dos_port/pokeyellow_dos.exe
dos_port/PKMN.EXE
dos_port/CWSDPMI.EXE
dos_port/CWSDPMI.SWP
*.SWP

# DOS port runtime debug dumps (rewritten by every DEBUG_* run; see the
# build-and-debug skill). FRAME_BASELINE.BIN is a checked-in reference and
# is deliberately NOT matched here.
dos_port/GBSTATE.BIN
# PAL.BIN is FRAME.BIN's palette companion (tools/render_frame.py reads it from
# beside FRAME.BIN to colorize a dump). Same class as FRAME/DUMP/GBSTATE — it was
# simply missed here, and showed up untracked after the colorization runtime landed.
dos_port/PAL.BIN

# DOSBox-X screen captures (command_*.png etc.) — regenerable, and written
# whenever a run captures a frame.
dos_port/capture/

# DOS port assets — generated .inc are ignored and reproduced by `make assets`.
# Every generator under dos_port/tools/generators/ has a Makefile rule with
# declared inputs (committed pret PNGs, or root-make .2bpp products after the
# mandated root `make`), so a fresh checkout rebuilds them; nothing rule-driven
# may be re-added below as a negation. History: 88c7f98f untracked all of
# assets/*.inc on 2026-06-30 and broke fresh-checkout builds the same day;
# dfe0cac9c re-tracked 21 outputs as "no `make` rule". That justification went
# stale as rules landed (mon_icons.inc since f8863164d; fonts/title/intro since
# the assets-audit), so the negation block was retired. Clean-tree proof:
# git clean -Xdf dos_port/assets && make assets (root `make` first).
# Use `dos_port/assets/*` so git still descends to negate the hand-authored
# sidecars below.
dos_port/assets/*
# UI layout sidecars: hand-positioned via tools/ui_layout/editor.py — the
# source of truth the generated ui_layout_*.inc is derived from. Must stay
# tracked; the .inc itself regenerates via `make assets`.
!dos_port/assets/ui_layout_*_sidecar.json
# Colorization sidecar: human-authored deltas; the generated .inc stays ignored.
!dos_port/assets/colors/
!dos_port/assets/colors/palettes.json
!dos_port/assets/colors/repaint/
!dos_port/assets/colors/repaint/*.png
!dos_port/assets/colors/repaint/*.2bpp

# ARR reference docs (MIDI/SoundBlaster/MT-32 specs) — cannot be committed
docs/sound/

# DOS save files
*.dsv

# MCP debugger: clone and binary are not committed (too large)
dos_port/tools/dosbox-x-mcp/

# mGBA fidelity-harness build output (source is the tools/mgba submodule)
dos_port/tools/mgba_build/

# Claude Code session data (settings.local.json, worktrees, etc.) — but keep
# shared project skills under version control.
.claude/*
!.claude/skills/

# OpenCode local session/configuration data
.opencode/
opencode.json

# precompiled python
*.pyc
*$py.class

# save game files
*.sgm
*.sav
*.rtc
*.sn*
*.sa*
*.sg1
# ...except committed test fixtures. dos_port/tests/fixtures holds real GB saves
# used as golden seed data (save_real_load stages one as POKEMON.DSV), so they
# have to be tracked. The rules above are for saves produced by RUNNING the port
# or an emulator, which must stay untracked.
!dos_port/tests/fixtures/**

# ARR score transcriptions
docs/references/pokemon_score_transcriptions/
pokemon_score_descriptions/

# Generated per-song analysis (music_analysis.py output — regenerable)
dos_port/tools/audio/analysis/

# Session handoff notes — local scratch, never committed (see stigmergy for anything durable)
handoff.md
handoff_s*.md

# Ephemeral journals — subagent/local investigation notes (docs/ephemeral*),
# safe pattern for anything that must never be committed. Durable findings
# belong in stigmergy memories, not here.
ephemeral*

# Windows toolchain installed by dos_port/tools/setup_toolchain.py (never committed;
# see the "Legal note" in README.md -- these are third-party GPL/BSD binaries we
# link to, not redistribute)
.toolchain/

# DOSBox-X staging dir created by the ps1 run scripts (mounted as C: on
# Windows, where PKMN.IMG cannot be built). Holds PKMN.EXE + CWSDPMI.EXE +
# the save; the scripts also write a self-ignoring .gitignore inside it.
dos_port/rundir/

# DOS port overworld inventory — regenerable survey outputs (run
# tools/overworld_inventory.py). A fresh checkout can't reproduce them until
# `make assets` has been run, so they are never committed.
dos_port/overworld/*.json
dos_port/overworld/*.md

# Node dependencies
node_modules/
dos_port/node_modules/

# Audio auditioning tool binaries and local revisions
dos_port/tools/audio/opl_synth
dos_port/tools/audio/libnukedopl.so
dos_port/tools/audio/libmidiout.so
dos_port/tools/audio/libgbapu.so
dos_port/tools/audio/.gb_snd_emu/
dos_port/tools/audio/.revisions/
